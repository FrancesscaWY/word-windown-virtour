{
  "name": "virtour-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "移动端景区导览与数字人伴游 Demo",
  "dependencies": {
    "@fastify/http-proxy": "^11.6.6",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "ws": "^8.22.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ricky0123/vad-web": "0.0.31",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "onnxruntime-web": "1.22.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "knowledge:import": "node scripts/import-knowledge.ts",
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "dev:lan": "node --env-file-if-exists=.env server/index.ts --lan",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:call-vad": "node scripts/prepare-call-vad.mjs",
    "calls:inspect": "node --env-file-if-exists=.env scripts/inspect-call.mjs",
    "chats:inspect": "node --env-file-if-exists=.env scripts/inspect-chat.mjs",
    "panoramas:crawl": "node --env-file-if-exists=.env scripts/crawl-panoramas.mjs",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "check": "npm run typecheck && node scripts/check.mjs",
    "typecheck": "tsc -p server/tsconfig.json",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node --env-file-if-exists=.env server/index.ts --dist",
    "deploy:package": "node scripts/package-site.mjs"
  }
}
