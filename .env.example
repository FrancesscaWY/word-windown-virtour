# 本机开发；npm run dev:lan 会显式监听所有 IPv4 网卡。
HOST=127.0.0.1
PORT=5174

# 留空文字密钥时运行明确标注的本地规则演示，不调用旧导览服务。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 原生语音直接在本服务端连接 Qwen，不需要文字模型密钥。
DASHSCOPE_API_KEY=
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_MODEL=qwen-audio-3.1-realtime-flash
QWEN_VOICE=longanqian_v3.1

# 可选 HTTPS，证书必须被设备信任并覆盖访问的域名或 IP。
TLS_CERT_PATH=
TLS_KEY_PATH=
