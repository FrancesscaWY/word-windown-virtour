# dev/start 共用 proxy 入口；以下仅配置对外端口，内部 API 自动绑定回环随机端口。
# 本机开发；npm run dev:lan 会显式监听所有 IPv4 网卡。
HOST=127.0.0.1
PORT=5174

# 仅当外层 HTTPS/隧道改写 Host 时，填写站点的完整公开 Origin（可逗号分隔）。
# 例如 https://tour.example.com:55555；不是模型 API 地址，不支持通配符。
PUBLIC_ORIGINS=

# 推荐将 Chat / 语音密钥放在仓库外、权限 0600 的凭据 .env 中。
# 文件内容支持 CHAT_API_KEY、DASHSCOPE_API_KEY；不要提交任何真实密钥。
AI_CREDENTIALS_FILE=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
# 也支持通过服务进程环境注入 CHAT_API_KEY / DASHSCOPE_API_KEY。
# 未配置密钥时明确返回 503；没有演示或模拟回答回退。

# 原生语音直接在本服务端连接 Qwen，不需要文字模型密钥。
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_MODEL=qwen-audio-3.1-realtime-flash
QWEN_VOICE=longanqian_v3.1

# 固定讲解、欢迎语及重听：阿里云百炼 Qwen TTS，复用 DASHSCOPE_API_KEY。
# TTS 与实时通话的模型/音色独立；不使用浏览器语音合成兜底。
QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry

# 完整通话事件与双方 PCM WAV，仅保存在服务端；默认项目 logs/calls。
# 可指定仓库外的绝对路径。日志包含对话内容，目录不由页面服务公开。
CALL_LOG_DIR=

# 文字 AI 对话诊断（输入、模型轮次、工具、回复及异常），默认项目 logs/chats。
# 仅服务端文件，不提供网页查询接口；使用 npm run chats:inspect 查看。
# 对话会落盘，含私人内容；请限制服务器访问并按需清理。可指定仓库外路径。
CHAT_LOG_DIR=

# 可选 HTTPS，证书必须被设备信任并覆盖访问的域名或 IP。
TLS_CERT_PATH=
TLS_KEY_PATH=
